{
  "name": "story-passport/community-ledger",
  "description": "Declared story terms and a mock community ledger",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "dompdf/dompdf": "^3.1",
    "endroid/qr-code": "^5.1",
    "phpmailer/phpmailer": "^7.0"
  },
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1"},
  "autoload": {"psr-4": {"Passport\\": "src/"}},
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse --memory-limit=512M", "check": ["@test", "@analyse"]},
  "config": {"sort-packages": true, "platform": {"php": "8.3.0"}}
}
